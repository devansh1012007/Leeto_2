# Copy to .env and fill in. Secrets are NEVER baked into images (02 §1.5).
ENV=dev
PG_HOST=postgres
PG_PORT=5432
PG_DB=bhctf
PG_USER=postgres
PG_PASSWORD=change-me
JWT_SECRET=change-me-to-32-bytes-minimum-secret
ADMIN_AUTH_MODE=shared_secret        # staging/prod: access (boot assertion refuses shared_secret)
RUNNER_MODE=stub                     # prod: real|off (stub refuses to boot in prod)
AI_KIND=stub                         # prod: local|off (remote requires privacy notice bump)
STORAGE_KIND=fs
STORAGE_PATH=/var/lib/bhctf/uploads
CORS_ALLOW_ORIGINS=http://app.local,http://admin.local
HTTP_PORT=80
# Internal health-probe ports for the loop-based services (RB-01); per-service override
PROBE_PORT=8010
