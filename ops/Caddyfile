# Dev edge (B5): Caddy is the only entry; apis are compose-internal.
# Prod: Cloudflare Tunnel → Caddy; NO published host ports.

app.local:80 {
	route {
		handle /v1/* {
			reverse_proxy api_participant:8000
		}
		handle {
			root * /srv/participant
			encode gzip
			try_files {path} /index.html
			file_server
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=63072000"
	}
}

admin.local:80 {
	route {
		handle /v1/* {
			reverse_proxy api_admin:8001
		}
		handle {
			root * /srv/admin
			encode gzip
			try_files {path} /index.html
			file_server
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
